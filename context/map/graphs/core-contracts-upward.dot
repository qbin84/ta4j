digraph core_contracts {
  graph [rankdir=TB, newrank=true, nodesep=0.8, ranksep=1.1, splines=true, fontname="Helvetica", fontsize=12,
         labelloc=t, label="Kogo dotyka zmiana kontraktów org.ta4j.core i które krawędzie wracają w górę (tylko krawędzie z/do core; runtime: jdeps + bajtkod)\nszare = pakiet zależy od core (liczba plików, które trzeba sprawdzić) · pomarańczowe przerywane = core sięga w górę z projektu / przez złą lokalizację typu · czerwone = core sięga w górę po logikę\nw węźle: warstwa, commity z 12 mies. (kod produkcyjny) i fan-in/fan-out w tym podgrafie"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.2,0.1"];
  edge [fontname="Helvetica", fontsize=9];
  { rank=same; "backtest" }
  { rank=same; "criteria.**" }
  { rank=same; "rules.**" "analysis" "analysis.cost" "serialization" }
  { rank=same; "core" "bars" }
  "backtest" -> "criteria.**" [style=invis];
  "criteria.**" -> "rules.**" [style=invis];
  "rules.**" -> "core" [style=invis];
  "backtest" [label="backtest\nL5 · 125 commitów\nfan-in 1 / fan-out 1", fillcolor="#e8eaf6"];
  "criteria.**" [label="criteria.**\nL4 · 115 commitów\nfan-in 0 / fan-out 1", fillcolor="#e3f2fd"];
  "rules.**" [label="rules.**\nL3 · 71 commitów\nfan-in 1 / fan-out 1", fillcolor="#e0f2f1"];
  "analysis" [label="analysis\nL3 · 114 commitów\nfan-in 1 / fan-out 1", fillcolor="#e0f2f1"];
  "analysis.cost" [label="analysis.cost\nL3 · 6 commitów\nfan-in 1 / fan-out 1", fillcolor="#e0f2f1"];
  "core" [label="core\nL1 · 143 commitów\nfan-in 7 / fan-out 6", fillcolor="#fff3e0", penwidth=2.5, color="#b71c1c"];
  "bars" [label="bars\nL1 · 6 commitów\nfan-in 1 / fan-out 1", fillcolor="#fff3e0"];
  "serialization" [label="serialization\nX · 73 commitów\nfan-in 1 / fan-out 1", fillcolor="#fce4ec"];
  "analysis" -> "core" [label="32", color="#9e9e9e", fontcolor="#757575"];
  "analysis.cost" -> "core" [label="8", color="#9e9e9e", fontcolor="#757575"];
  "backtest" -> "core" [label="49", color="#9e9e9e", fontcolor="#757575"];
  "bars" -> "core" [label="36", color="#9e9e9e", fontcolor="#757575"];
  "core" -> "analysis" [label="3 (wstecz: 32)\nAnalysisCriterion → AnalysisContext\nAnalysisCriterion → AnalysisWindow\nAnalysisCriterion → OpenPositionHandling", color="#ef6c00", fontcolor="#ef6c00", style=dashed, penwidth=1.6, constraint=false];
  "core" -> "analysis.cost" [label="14 (wstecz: 8)\nAnalysisCriterion → CostModel\nAnalysisCriterion → ZeroCostModel\nBaseTrade → CostModel\n…", color="#ef6c00", fontcolor="#ef6c00", style=dashed, penwidth=1.6, constraint=false];
  "core" -> "backtest" [label="1 (wstecz: 49)\nAnalysisCriterion → BarSeriesManager", color="#c62828", fontcolor="#c62828", penwidth=2.2, constraint=false];
  "core" -> "bars" [label="4", color="#9e9e9e", fontcolor="#757575"];
  "core" -> "rules.**" [label="5 (wstecz: 145)\nBaseStrategy → RuleCopies\nRule → AndRule\nRule → NotRule\n…", color="#c62828", fontcolor="#c62828", penwidth=2.2, constraint=false];
  "core" -> "serialization" [label="5 (wstecz: 15)\nAnalysisCriterion → AnalysisCriterionSerialization\nIndicator → IndicatorSerialization\nRule → ComponentSerialization\n…", color="#ef6c00", fontcolor="#ef6c00", style=dashed, penwidth=1.6, constraint=false];
  "criteria.**" -> "core" [label="178", color="#9e9e9e", fontcolor="#757575"];
  "rules.**" -> "core" [label="145", color="#9e9e9e", fontcolor="#757575"];
  "serialization" -> "core" [label="15", color="#9e9e9e", fontcolor="#757575"];
}
